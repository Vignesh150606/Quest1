# Base URL of the local FastAPI backend, no trailing slash. Matches
# `uvicorn api.app:app --port 8000` running on the same machine.
#
# If this frontend is deployed elsewhere (e.g. Vercel) while the backend stays on your
# own computer, the browser running the deployed frontend cannot reach
# http://localhost:8000 -- that address only means "this machine" to whichever machine
# is running the browser. There's no way around this without exposing your machine to
# the internet (a tunnel like ngrok, port forwarding, etc.) or running the backend
# somewhere reachable -- see README's "Local Web App" section.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
