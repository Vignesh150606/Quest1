# Backend (api/) environment variables. Copy to .env for local dev if you use a tool
# that loads it (uvicorn itself does not auto-load .env -- see README for how to pass
# these when running locally). None of these are secrets; nothing here should ever be
# a real API key or credential.

# Comma-separated list of frontend origins allowed to call this API (CORS). Local dev
# default matches `npm run dev`'s default port.
ALLOWED_ORIGINS=http://localhost:3000

# Force-disable the OCR track regardless of confidence -- same flag as the CLI's
# --skip-ocr, exposed here because OCR is known to crash under Docker Desktop's WSL2
# locally (see Dockerfile's comments); whether it also fails on Render is unverified
# until deployed.
QUEST1_SKIP_OCR=false

# How many jobs the background thread pool processes concurrently (see api/jobs.py).
QUEST1_MAX_CONCURRENT_JOBS=2

# Where job output (report.json + frame PNGs) is written, one subfolder per job_id.
QUEST1_OUTPUT_ROOT=./output

# Download/cache directory for yt-dlp + extracted audio (same as the CLI's --work-dir).
# Leave unset to use ingest.py's own default (./.cache).
QUEST1_WORK_DIR=
